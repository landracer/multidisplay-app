DESTDIR       = ../lib/
TARGET        = libqwt.so.6.1.1
TARGETA       = ../lib/libqwt.a
TARGET0       = libqwt.so
TARGETD       = libqwt.so.6.1.1
TARGET1       = libqwt.so.6
TARGET2       = libqwt.so.6.1


first: all
####### Build rules

../lib/libqwt.so.6.1.1:  $(OBJECTS) $(SUBLIBS) $(OBJCOMP)  
	@test -d ../lib/ || mkdir -p ../lib/
	-$(DEL_FILE) $(TARGET) $(TARGET0) $(TARGET1) $(TARGET2)
	$(LINK) $(LFLAGS) -o $(TARGET) $(OBJECTS) $(LIBS) $(OBJCOMP)
	-ln -s $(TARGET) $(TARGET0)
	-ln -s $(TARGET) $(TARGET1)
	-ln -s $(TARGET) $(TARGET2)
	-$(DEL_FILE) ../lib/$(TARGET)
	-$(MOVE) $(TARGET) ../lib/$(TARGET)
	-$(DEL_FILE) ../lib/$(TARGET0)
	-$(DEL_FILE) ../lib/$(TARGET1)
	-$(DEL_FILE) ../lib/$(TARGET2)
	-$(MOVE) $(TARGET0) ../lib/$(TARGET0)
	-$(MOVE) $(TARGET1) ../lib/$(TARGET1)
	-$(MOVE) $(TARGET2) ../lib/$(TARGET2)



staticlib: ../lib/libqwt.a

../lib/libqwt.a:  $(OBJECTS) $(OBJCOMP) 
	-$(DEL_FILE) $(TARGETA) 
	$(AR) $(TARGETA) $(OBJECTS)

