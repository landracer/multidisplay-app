####### Install

install_target: first FORCE
	@test -d $(INSTALL_ROOT)/usr/local/qwt-6.2.0/lib || mkdir -p $(INSTALL_ROOT)/usr/local/qwt-6.2.0/lib
	$(QINSTALL_PROGRAM) ../lib/$(TARGET) $(INSTALL_ROOT)/usr/local/qwt-6.2.0/lib/$(TARGET)
	-$(SYMLINK) $(TARGET) $(INSTALL_ROOT)/usr/local/qwt-6.2.0/lib/$(TARGET0)
	-$(SYMLINK) $(TARGET) $(INSTALL_ROOT)/usr/local/qwt-6.2.0/lib/$(TARGET1)
	-$(SYMLINK) $(TARGET) $(INSTALL_ROOT)/usr/local/qwt-6.2.0/lib/$(TARGET2)
	@test -d $(INSTALL_ROOT)/usr/local/qwt-6.2.0/lib/pkgconfig || mkdir -p $(INSTALL_ROOT)/usr/local/qwt-6.2.0/lib/pkgconfig
	$(INSTALL_FILE) ../lib/pkgconfig/Qt6Qwt6.pc $(INSTALL_ROOT)/usr/local/qwt-6.2.0/lib/pkgconfig/Qt6Qwt6.pc

uninstall_target: FORCE
	-$(DEL_FILE) $(INSTALL_ROOT)/usr/local/qwt-6.2.0/lib/$(TARGET) 
	 -$(DEL_FILE) $(INSTALL_ROOT)/usr/local/qwt-6.2.0/lib/$(TARGET0) 
	 -$(DEL_FILE) $(INSTALL_ROOT)/usr/local/qwt-6.2.0/lib/$(TARGET1) 
	 -$(DEL_FILE) $(INSTALL_ROOT)/usr/local/qwt-6.2.0/lib/$(TARGET2) 
	 -$(DEL_FILE) $(INSTALL_ROOT)/usr/local/qwt-6.2.0/lib/pkgconfig/Qt6Qwt6.pc
	-$(DEL_DIR) $(INSTALL_ROOT)/usr/local/qwt-6.2.0/lib/ 


