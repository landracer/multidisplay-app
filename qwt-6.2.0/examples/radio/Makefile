	-$(DEL_FILE) moc/moc_predefs.h
moc/moc_predefs.h: /usr/lib64/qt6/mkspecs/features/data/dummy.cpp
	@echo generating moc/moc_predefs.h
	@g++ -pipe -fno-math-errno -funsafe-math-optimizations -O2 -Wall -Wextra -dM -E -o moc/moc_predefs.h /usr/lib64/qt6/mkspecs/features/data/dummy.cpp

compiler_moc_header_make_all: moc/moc_AmplifierBox.cpp moc/moc_TunerBox.cpp
compiler_moc_header_clean:
	-$(DEL_FILE) moc/moc_AmplifierBox.cpp moc/moc_TunerBox.cpp
moc/moc_AmplifierBox.cpp: AmplifierBox.h \
		../../classincludes/QwtGlobal \
		../../src/qwt_global.h \
		moc/moc_predefs.h \
		/usr/libexec/qt6/moc
	@echo moc AmplifierBox.h && /usr/libexec/qt6/moc $(DEFINES) --include /home/sysadmin/Documents/multidisplay-app/multidisplay-app/qwt-6.2.0/examples/radio/moc/moc_predefs.h -I/usr/lib64/qt6/mkspecs/linux-g++ -I/home/sysadmin/Documents/multidisplay-app/multidisplay-app/qwt-6.2.0/examples/radio -I/home/sysadmin/Documents/multidisplay-app/multidisplay-app/qwt-6.2.0/src -I/home/sysadmin/Documents/multidisplay-app/multidisplay-app/qwt-6.2.0/classincludes -I/usr/include/qt6 -I/usr/include/qt6/QtPrintSupport -I/usr/include/qt6/QtOpenGLWidgets -I/usr/include/qt6/QtWidgets -I/usr/include/qt6/QtOpenGL -I/usr/include/qt6/QtSvg -I/usr/include/qt6/QtGui -I/usr/include/qt6/QtConcurrent -I/usr/include/qt6/QtCore -I/usr/include/c++/15 -I/usr/include/c++/15/x86_64-suse-linux -I/usr/include/c++/15/backward -I/usr/lib64/gcc/x86_64-suse-linux/15/include -I/usr/local/include -I/usr/lib64/gcc/x86_64-suse-linux/15/include-fixed -I/usr/x86_64-suse-linux/include -I/usr/include AmplifierBox.h -o moc/moc_AmplifierBox.cpp

