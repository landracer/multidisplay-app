####### Compile

obj/AmplifierBox.o: AmplifierBox.cpp AmplifierBox.h \
		../../classincludes/QwtGlobal \
		../../src/qwt_global.h \
		../../classincludes/QwtKnob \
		../../src/qwt_knob.h \
		../../src/qwt_abstract_slider.h \
		../../src/qwt_abstract_scale.h \
		../../classincludes/QwtThermo \
		../../src/qwt_thermo.h \
		../../src/qwt_interval.h \
		../../classincludes/QwtRoundScaleDraw \
		../../src/qwt_round_scale_draw.h \
		../../src/qwt_abstract_scale_draw.h \
		../../src/qwt_scale_div.h \
		../../classincludes/QwtMath \
		../../src/qwt_math.h \
		moc/moc_AmplifierBox.cpp
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/AmplifierBox.o AmplifierBox.cpp

obj/TunerBox.o: TunerBox.cpp TunerBox.h \
		../../classincludes/QwtWheel \
		../../src/qwt_wheel.h \
		../../src/qwt_global.h \
		../../classincludes/QwtSlider \
		../../src/qwt_slider.h \
		../../src/qwt_abstract_slider.h \
		../../src/qwt_abstract_scale.h \
		../../classincludes/QwtThermo \
		../../src/qwt_thermo.h \
		../../src/qwt_interval.h \
		../../classincludes/QwtMath \
		../../src/qwt_math.h \
		moc/moc_TunerBox.cpp
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/TunerBox.o TunerBox.cpp

obj/main.o: main.cpp TunerBox.h \
		AmplifierBox.h \
		../../classincludes/QwtGlobal \
		../../src/qwt_global.h
	$(CXX) -c $(CXXFLAGS) $(INCPATH) -o obj/main.o main.cpp

